# 忽略本地 Claude 设置，但发布可移植的导师镜像及其运行时引用，
# 让全新克隆也能发现它们。
!.claude/
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/check-understanding/
!.claude/skills/claude-certification/
!.claude/skills/course-guide/
!.claude/skills/find-your-level/
!.claude/skills/find-your-level/**
!.claude/skills/learn-agent-skills/
!.claude/skills/learn-mcp/
!.claude/skills/learn/
!.claude/skills/start-learning/
catalog.json

# 每次 Vercel 部署时由 site/build.js（buildCommand）生成——切勿提交，
# 以免内容漂移或丢失 URL；始终根据 PHASES 重新生成。
site/sitemap.xml
site/llms.txt
site/build-meta.js
site/certification-data.js
site/figure-manifest.js
site/lesson-seo.json
site/certification-seo.json
site/i18n-data.js
site/i18n-figures.js
site/i18n-glossary.js
site/i18n-quizzes-zh-*.json
site/i18n-search-zh-*.json
site/i18n-generated/
book/_build/

# 课程翻译通常生成到独立的 `translations` 分支，而不是 main。
# 这个中文专用发行分支会直接跟踪人工审核过的简体中文课程正文与来源缓存，
# 以保证站点代码和中文内容能够作为同一个原子版本发布。
i18n/*/phases/
i18n/*/.cache/
!i18n/zh/phases/
!i18n/zh/phases/**
!i18n/zh/.cache/
!i18n/zh/.cache/**
i18n/*/.translate-cache.json
site/langs.js
